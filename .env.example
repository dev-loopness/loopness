# ReviewLoop settings. Copy this file to ".env.local" and paste your values after the "=".
# Leave everything blank to run in DEMO MODE (no Whop connection, fake users).
# CONNECT.md explains exactly where each value comes from. Never paste these into chat.

# --- From your Whop developer app (whop.com/dashboard/developer -> your app) ---
# The app's ID. Starts with "app_".
WHOP_APP_ID=
# The app's API key. Secret: keep it private.
WHOP_API_KEY=
# Same value as WHOP_APP_ID. The browser side of the app needs its own copy.
NEXT_PUBLIC_WHOP_APP_ID=

# --- From your own ReviewLoop business on Whop (where you sell Pro and Team) ---
# Your business ID. Starts with "biz_".
REVIEWLOOP_BUSINESS_ID=
# An API key for that business (Business settings -> API keys), so the app can see who bought Pro or Team.
# Needs permission to read memberships. Secret: keep it private.
REVIEWLOOP_BUSINESS_API_KEY=
# The plan IDs for the Pro ($39) and Team ($99) plans. Start with "plan_".
# If you also sell yearly versions, put them on the *_YEARLY lines.
WHOP_PRO_PLAN_ID=
WHOP_PRO_YEARLY_PLAN_ID=
WHOP_TEAM_PLAN_ID=
WHOP_TEAM_YEARLY_PLAN_ID=

# --- Hosting (only when the app runs on a server) ---
# Where the app is hosted, e.g. https://reviewloop.up.railway.app
APP_URL=
# Folder where submissions and uploaded videos are saved. Point it at the host's
# persistent disk (for example /data). Blank = a "data" folder next to the app.
DATA_DIR=
